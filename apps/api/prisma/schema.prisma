generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_system_metadata")
}

model IdentityUser {
  id        String        @id @default(uuid()) @db.Uuid
  phone     String        @unique
  createdAt DateTime      @default(now())
  sessions  AuthSession[]
  roleGrants RoleGrant[]
  artistProducts ArtistProduct[]
  publicationEvents ProductPublicationEvent[]
  inventoryEvents ProductInventoryEvent[]
  customerCart CustomerCart?
  addressBook CustomerAddressBook?
  customerOrders CustomerOrder[]
  paymentEvents PaymentEvent[]
  payableQuotes OrderPayableQuote[]
  fulfillments ArtistOrderPreparation[]
  preparationEvents OrderPreparationEvent[]
  shipmentReports ArtistShipmentReport[]
  shipmentReceipts CustomerShipmentReceipt[]
  shipmentIssues CustomerShipmentIssue[]
  shipmentIssueEvents ShipmentIssueEvent[]
  refundReviews ShipmentRefundReview[]
  financialSubjects FinancialEvent[] @relation("FinancialSubject")
  financialActors FinancialEvent[] @relation("FinancialActor")
  serviceRequests ServiceRequest[] @relation("ServiceArtist")
  createdServiceRequests ServiceRequest[] @relation("ServiceCreator")
  serviceAssignments ServiceAssignment[]
  serviceEvents ServiceRequestEvent[]
  serviceExecutionEvents ServiceExecutionEvent[]
  serviceDeliverableFiles ServiceDeliverableFile[]
  createdServiceCatalogItems ServiceCatalogItem[] @relation("ServiceCatalogCreator")
  serviceCatalogEvents ServiceCatalogEvent[] @relation("ServiceCatalogActor")

  @@map("identity_users")
}

model ServiceCatalogItem {
  id String @id @default(uuid()) @db.Uuid
  createdByUserId String @db.Uuid
  creator IdentityUser @relation("ServiceCatalogCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.Uuid
  title String
  description String
  isActive Boolean @default(false)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requests ServiceRequest[]
  events ServiceCatalogEvent[]
  @@unique([createdByUserId, idempotencyKey])
  @@index([isActive, createdAt, id])
  @@map("service_catalog_items")
}

model ServiceCatalogEvent {
  id String @id @default(uuid()) @db.Uuid
  itemId String @db.Uuid
  item ServiceCatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  version Int
  action String
  actorUserId String @db.Uuid
  actor IdentityUser @relation("ServiceCatalogActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  command Json
  requestTraceId String
  createdAt DateTime @default(now())
  @@unique([itemId, version])
  @@map("service_catalog_events")
}

enum ServiceRequestStatus {
  awaiting_assignment
  assigned
  accepted
}

enum ServiceAssignmentStatus {
  assigned
  accepted
  declined
}

model ServiceRequest {
  id String @id @default(uuid()) @db.Uuid
  serviceCatalogItemId String? @db.Uuid
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id], onDelete: Restrict)
  artistUserId String @db.Uuid
  artist IdentityUser @relation("ServiceArtist", fields: [artistUserId], references: [id], onDelete: Restrict)
  createdByUserId String @db.Uuid
  creator IdentityUser @relation("ServiceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.Uuid
  title String
  description String
  internalNote String?
  status ServiceRequestStatus @default(awaiting_assignment)
  version Int @default(0)
  createdAt DateTime @default(now())
  assignments ServiceAssignment[]
  events ServiceRequestEvent[]
  @@unique([createdByUserId, idempotencyKey])
  @@index([serviceCatalogItemId])
  @@index([artistUserId, createdAt, id])
  @@index([status, createdAt, id])
  @@map("service_requests")
}

model ServiceAssignment {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  partnerOrganizationId String @db.Uuid
  partnerUserId String @db.Uuid
  partner IdentityUser @relation(fields: [partnerUserId], references: [id], onDelete: Restrict)
  assignedVersion Int
  status ServiceAssignmentStatus @default(assigned)
  responseSummary String?
  assignedAt DateTime @default(now())
  respondedAt DateTime?
  events ServiceRequestEvent[]
  @@unique([requestId, assignedVersion])
  execution ServiceExecution?
  @@unique([id, requestId])
  @@index([partnerOrganizationId, partnerUserId, assignedAt, id])
  @@map("service_assignments")
}

enum ServiceExecutionStatus {
  accepted
  scheduled
  in_progress
  submitted
  changes_requested
  completed
}

model ServiceExecution {
  assignmentId String @id @db.Uuid
  assignment ServiceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  status ServiceExecutionStatus @default(accepted)
  version Int @default(0)
  scheduledStart DateTime?
  scheduledEnd DateTime?
  scheduleSummary String?
  progressSummary String?
  submissionSummary String?
  reviewSummary String?
  submittedFileIds String[] @default([]) @db.Uuid
  updatedAt DateTime @default(now()) @updatedAt
  events ServiceExecutionEvent[]
  files ServiceDeliverableFile[]
  @@map("service_executions")
}

model ServiceExecutionEvent {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  execution ServiceExecution @relation(fields: [assignmentId], references: [assignmentId], onDelete: Restrict)
  version Int
  fromStatus ServiceExecutionStatus?
  toStatus ServiceExecutionStatus
  summary String
  actorUserId String @db.Uuid
  actor IdentityUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  command Json
  requestTraceId String
  fileIds String[] @default([]) @db.Uuid
  createdAt DateTime @default(now())
  @@unique([assignmentId, version])
  @@map("service_execution_events")
}

model ServiceDeliverableFile {
  id String @id @default(uuid()) @db.Uuid
  assignmentId String @db.Uuid
  execution ServiceExecution @relation(fields: [assignmentId], references: [assignmentId], onDelete: Restrict)
  uploadedByUserId String @db.Uuid
  uploader IdentityUser @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  idempotencyKey String @db.Uuid
  commandHash String
  uploadedExecutionVersion Int
  label String
  objectKey String @unique
  contentType String
  byteLength Int
  sha256 String
  createdAt DateTime @default(now())
  @@unique([assignmentId, idempotencyKey])
  @@unique([assignmentId, uploadedExecutionVersion])
  @@map("service_deliverable_files")
}

model ServiceRequestEvent {
  id String @id @default(uuid()) @db.Uuid
  requestId String @db.Uuid
  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  assignmentId String? @db.Uuid
  assignment ServiceAssignment? @relation(fields: [assignmentId, requestId], references: [id, requestId], onDelete: Restrict)
  version Int
  action String
  actorUserId String @db.Uuid
  actor IdentityUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  command Json
  requestTraceId String
  createdAt DateTime @default(now())
  @@unique([requestId, version])
  @@map("service_request_events")
}

enum ProductPublicationStatus {
  draft
  under_review
  changes_requested
  approved
  published
}

model ArtistProduct {
  id                String                   @id @default(uuid()) @db.Uuid
  artistUserId      String                   @db.Uuid
  artist            IdentityUser             @relation(fields: [artistUserId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  category          String?
  dimensions        String?
  materials         String?
  weight            String?
  color             String?
  technique         String?
  imageIds          String[]                 @default([]) @db.Uuid
  images            ProductImage[]
  cartItems         CartItem[]
  orderItems        CustomerOrderItem[]
  careInstructions  String?
  priceToman        BigInt
  publicationStatus ProductPublicationStatus @default(draft)
  version           Int                      @default(0)
  publicationEvents ProductPublicationEvent[]
  stockQuantity     Int                      @default(0)
  inventoryVersion  Int                      @default(0)
  inventoryEvents   ProductInventoryEvent[]
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@index([artistUserId, archivedAt, updatedAt])
  @@index([publicationStatus, archivedAt])
  @@index([publicationStatus, archivedAt, createdAt, id])
  @@index([publicationStatus, archivedAt, priceToman, id])
  @@map("artist_products")
}

// Append-only through inventory commands; no update/delete API.
model ProductInventoryEvent {
  id               String        @id @default(uuid()) @db.Uuid
  productId        String        @db.Uuid
  product          ArtistProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUserId      String?       @db.Uuid
  actor            IdentityUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  orderId          String?       @db.Uuid
  order            CustomerOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  previousQuantity Int
  stockQuantity    Int
  inventoryVersion Int
  reason           String?
  requestId        String
  createdAt        DateTime      @default(now())

  @@unique([productId, inventoryVersion])
  @@map("product_inventory_events")
}

model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int       @default(0)
  requestCount   Int       @default(1)
  windowStartedAt DateTime
  nextRequestAt  DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("otp_challenges")
}

model AuthSession {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  revokedAt DateTime?
  activeGrantId String?    @db.Uuid
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

enum IdentityRole {
  customer
  artist
  staff
  service_partner
  supporting_organization
  corporate_buyer
  export_partner
}

model RoleGrant {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  user            IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            IdentityRole
  organizationId  String?      @db.Uuid
  exportPartnerId String?      @db.Uuid
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  staffDomains    StaffDomainGrant[]

  @@index([userId, revokedAt])
  @@map("role_grants")
}

model StaffDomainGrant {
  id        String    @id @default(uuid()) @db.Uuid
  roleGrantId String  @db.Uuid
  roleGrant RoleGrant @relation(fields: [roleGrantId], references: [id], onDelete: Cascade)
  domain    String

  @@unique([roleGrantId, domain])
  @@map("staff_domain_grants")
}

// Append-only through application commands; no update/delete API is exposed.
model ProductPublicationEvent {
  id          String                   @id @default(uuid()) @db.Uuid
  productId   String                   @db.Uuid
  product     ArtistProduct            @relation(fields: [productId], references: [id], onDelete: Restrict)
  actorUserId String                   @db.Uuid
  actor       IdentityUser             @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorRole   IdentityRole
  action      String
  fromStatus  ProductPublicationStatus
  toStatus    ProductPublicationStatus
  version     Int
  reason      String?
  content     Json
  requestId   String
  createdAt   DateTime                 @default(now())

  @@unique([productId, version])
  @@index([productId, createdAt])
  @@map("product_publication_events")
}

// Immutable media retained for publication-history references.
model ProductImage {
  id          String        @id @db.Uuid
  productId   String        @db.Uuid
  product     ArtistProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  objectKey   String        @unique
  width       Int
  height      Int
  byteLength  Int
  createdAt   DateTime      @default(now())

  @@index([productId])
  @@map("product_images")
}

model CustomerCart {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @unique @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  version   Int          @default(0)
  items     CartItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("customer_carts")
}

model CartItem {
  cartId    String        @db.Uuid
  cart      CustomerCart  @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String        @db.Uuid
  product   ArtistProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@id([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model CustomerAddressBook {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @unique @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  version   Int          @default(0)
  addresses CustomerAddress[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@map("customer_address_books")
}

model CustomerAddress {
  id            String @id @default(uuid()) @db.Uuid
  bookId        String @db.Uuid
  book          CustomerAddressBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  recipientName String
  recipientPhone String
  province      String
  city          String
  postalCode    String
  fullAddress   String
  isDefault     Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([bookId, createdAt, id])
  @@map("customer_addresses")
}

enum CustomerOrderStatus {
  reserved
  cancelled
  expired
  placed
}

enum OrderPaymentStatus {
  unpaid
  paid
  reconciliation_required
}

enum PaymentAttemptStatus {
  initializing
  pending
  failed
  succeeded
  reconciliation_required
}

model CustomerOrder {
  id                String @id @default(uuid()) @db.Uuid
  userId            String @db.Uuid
  user              IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  idempotencyKey    String @db.Uuid
  requestHash       String
  status            CustomerOrderStatus @default(reserved)
  version           Int @default(0)
  shippingAddress   Json
  subtotalToman     String
  reservedUntil     DateTime
  releasedAt        DateTime?
  createdAt         DateTime @default(now())
  paymentStatus     OrderPaymentStatus @default(unpaid)
  paidAt            DateTime?
  payableQuote      OrderPayableQuote?
  payments          PaymentAttempt[]
  financialEvents   FinancialEvent[]
  refundReviews     ShipmentRefundReview[]
  preparations      ArtistOrderPreparation[]
  items             CustomerOrderItem[]
  inventoryEvents   ProductInventoryEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt, id])
  @@index([status, reservedUntil, id])
  @@map("customer_orders")
}

model CustomerOrderItem {
  artistUserId      String @db.Uuid
  preparation       ArtistOrderPreparation @relation(fields: [orderId, artistUserId], references: [orderId, artistUserId], onDelete: Restrict)
  orderId           String @db.Uuid
  order             CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId         String @db.Uuid
  product           ArtistProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  title             String
  unitPriceToman    BigInt
  quantity          Int
  imageIds          String[] @default([]) @db.Uuid

  @@id([orderId, productId])
  @@index([productId])
  @@map("customer_order_items")
}

model OrderPayableQuote {
  orderId String @id @db.Uuid
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdByUserId String @db.Uuid
  creator IdentityUser @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  shippingFeeToman String
  payableToman String
  sourceReference String
  expiresAt DateTime
  createdAt DateTime @default(now())
  payments PaymentAttempt[]
  @@map("order_payable_quotes")
}

model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  quote OrderPayableQuote @relation(fields: [orderId], references: [orderId], onDelete: Restrict, map: "payment_attempts_quote_fkey")
  idempotencyKey String @db.Uuid
  requestHash String
  provider String
  providerReference String?
  redirectUrl String?
  amountToman String
  status PaymentAttemptStatus @default(initializing)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  receipt PaymentReceipt?
  events PaymentEvent[]
  @@unique([orderId, idempotencyKey])
  @@unique([provider, providerReference])
  @@index([orderId, createdAt, id])
  @@map("payment_attempts")
}

model PaymentReceipt {
  financialEvents FinancialEvent[]
  refundReviews ShipmentRefundReview[]
  id String @id @default(uuid()) @db.Uuid
  attemptId String @unique @db.Uuid
  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  provider String
  transactionReference String
  amount String
  unit String
  receivedAt DateTime @default(now())
  @@unique([provider, transactionReference])
  @@map("payment_receipts")
}

model PaymentEvent {
  id String @id @default(uuid()) @db.Uuid
  attemptId String @db.Uuid
  attempt PaymentAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  version Int
  status PaymentAttemptStatus
  reason String
  actorUserId String? @db.Uuid
  actor IdentityUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String
  createdAt DateTime @default(now())
  @@unique([attemptId, version])
  @@map("payment_events")
}

enum OrderPreparationStatus {
  awaiting_acceptance
  accepted
  preparing
  packaging
  ready_for_dispatch
}

model ArtistOrderPreparation {
  orderId String @db.Uuid
  artistUserId String @db.Uuid
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  artist IdentityUser @relation(fields: [artistUserId], references: [id], onDelete: Restrict)
  status OrderPreparationStatus @default(awaiting_acceptance)
  version Int @default(0)
  updatedAt DateTime @updatedAt
  items CustomerOrderItem[]
  events OrderPreparationEvent[]
  shipment ArtistShipmentReport?
  @@id([orderId, artistUserId])
  @@index([artistUserId, orderId])
  @@map("artist_order_preparations")
}

model OrderPreparationEvent {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  artistUserId String @db.Uuid
  preparation ArtistOrderPreparation @relation(fields: [orderId, artistUserId], references: [orderId, artistUserId], onDelete: Restrict)
  version Int
  fromStatus OrderPreparationStatus
  toStatus OrderPreparationStatus
  actorUserId String @db.Uuid
  actor IdentityUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String
  createdAt DateTime @default(now())
  @@unique([orderId, artistUserId, version])
  @@map("order_preparation_events")
}

// Immutable Artist declaration. Carrier verification and delivery are separate future workflows.
model ArtistShipmentReport {
  id String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  artistUserId String @db.Uuid
  preparation ArtistOrderPreparation @relation(fields: [orderId, artistUserId], references: [orderId, artistUserId], onDelete: Restrict, map: "artist_shipment_reports_preparation_fkey")
  customerVersion Int @default(0)
  receipt CustomerShipmentReceipt?
  issue CustomerShipmentIssue?
  preparationVersion Int
  carrierName String
  trackingCode String
  reportedAt DateTime @default(now())
  reportedByUserId String @db.Uuid
  reporter IdentityUser @relation(fields: [reportedByUserId], references: [id], onDelete: Restrict)
  requestId String
  @@unique([orderId, artistUserId])
  @@map("artist_shipment_reports")
}

enum ShipmentIssueKind {
  not_received
  damaged
  wrong_items
  missing_items
}
model CustomerShipmentReceipt {
  shipmentId String @id @db.Uuid
  shipment ArtistShipmentReport @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  commandVersion Int
  customerUserId String @db.Uuid
  customer IdentityUser @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  receivedAt DateTime @default(now())
  requestId String
  @@map("customer_shipment_receipts")
}
model CustomerShipmentIssue {
  refundReviews ShipmentRefundReview[]
  status ShipmentIssueStatus @default(open)
  version Int @default(0)
  resolution ShipmentIssueResolution?
  resolutionSummary String?
  events ShipmentIssueEvent[]
  shipmentId String @id @db.Uuid
  shipment ArtistShipmentReport @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  commandVersion Int
  customerUserId String @db.Uuid
  customer IdentityUser @relation(fields: [customerUserId], references: [id], onDelete: Restrict)
  kind ShipmentIssueKind
  description String
  reportedAt DateTime @default(now())
  requestId String
  @@index([status, reportedAt, shipmentId])
  @@map("customer_shipment_issues")
}

enum ShipmentIssueStatus {
  open
  in_review
  closed
}
enum ShipmentIssueResolution {
  customer_follow_up_complete
  referred_for_refund_review
}
model ShipmentIssueEvent {
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  issue CustomerShipmentIssue @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  version Int
  fromStatus ShipmentIssueStatus
  toStatus ShipmentIssueStatus
  resolution ShipmentIssueResolution?
  summary String
  actorUserId String @db.Uuid
  actor IdentityUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String
  createdAt DateTime @default(now())
  @@unique([shipmentId, version])
  @@map("shipment_issue_events")
}

enum RefundReviewDecision {
  approved
  rejected
}
model ShipmentRefundReview {
  financialEvents FinancialEvent[]
  id String @id @default(uuid()) @db.Uuid
  shipmentId String @db.Uuid
  issue CustomerShipmentIssue @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  issueVersion Int
  orderId String @db.Uuid
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receiptId String? @db.Uuid
  receipt PaymentReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  decision RefundReviewDecision
  amountToman String?
  reason String
  actorUserId String @db.Uuid
  actor IdentityUser @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String
  reviewedAt DateTime @default(now())
  @@unique([shipmentId, issueVersion])
  @@index([orderId, decision])
  @@map("shipment_refund_reviews")
}

enum FinancialEventKind {
  payment_received
  sale_verified
  refund_approved
  refund_rejected
}
model FinancialEvent {
  id String @id @default(uuid()) @db.Uuid
  eventKey String @unique
  kind FinancialEventKind
  orderId String @db.Uuid
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  artistUserId String? @db.Uuid
  artist IdentityUser? @relation("FinancialSubject", fields: [artistUserId], references: [id], onDelete: Restrict)
  paymentReceiptId String? @db.Uuid
  paymentReceipt PaymentReceipt? @relation(fields: [paymentReceiptId], references: [id], onDelete: Restrict)
  refundReviewId String? @db.Uuid
  refundReview ShipmentRefundReview? @relation(fields: [refundReviewId], references: [id], onDelete: Restrict)
  amountToman String?
  actorUserId String @db.Uuid
  actor IdentityUser @relation("FinancialActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  requestId String
  occurredAt DateTime
  recordedAt DateTime @default(now())
  @@index([artistUserId, occurredAt, id])
  @@index([orderId, occurredAt, id])
  @@map("financial_events")
}
