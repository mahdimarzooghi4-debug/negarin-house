generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_system_metadata")
}

model IdentityUser {
  id        String        @id @default(uuid()) @db.Uuid
  phone     String        @unique
  createdAt DateTime      @default(now())
  sessions  AuthSession[]
  roleGrants RoleGrant[]

  @@map("identity_users")
}

model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int       @default(0)
  requestCount   Int       @default(1)
  windowStartedAt DateTime
  nextRequestAt  DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("otp_challenges")
}

model AuthSession {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  revokedAt DateTime?
  activeGrantId String?    @db.Uuid
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

enum IdentityRole {
  customer
  artist
  staff
  service_partner
  supporting_organization
  corporate_buyer
  export_partner
}

model RoleGrant {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  user            IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            IdentityRole
  organizationId  String?      @db.Uuid
  exportPartnerId String?      @db.Uuid
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  staffDomains    StaffDomainGrant[]

  @@index([userId, revokedAt])
  @@map("role_grants")
}

model StaffDomainGrant {
  id        String    @id @default(uuid()) @db.Uuid
  roleGrantId String  @db.Uuid
  roleGrant RoleGrant @relation(fields: [roleGrantId], references: [id], onDelete: Cascade)
  domain    String

  @@unique([roleGrantId, domain])
  @@map("staff_domain_grants")
}
