generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model SystemMetadata {
  key       String   @id
  value     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("_system_metadata")
}

model IdentityUser {
  id        String        @id @default(uuid()) @db.Uuid
  phone     String        @unique
  createdAt DateTime      @default(now())
  sessions  AuthSession[]
  roleGrants RoleGrant[]
  artistProducts ArtistProduct[]
  productPublicationEvents ProductPublicationEvent[]
  serviceAssignments ServiceAssignment[] @relation("ServiceAssignmentUser")
  authoredServiceAssignments ServiceAssignment[] @relation("ServiceAssignmentAuthor")
  serviceAssignmentResponses ServiceAssignmentEvent[]
  uploadedServiceDeliverables ServiceDeliverable[]
  serviceDeliverableSubmissions ServiceDeliverableSubmission[]

  @@map("identity_users")
}

enum OrganizationKind {
  service_partner
  supporting_organization
  corporate_buyer
}

model Organization {
  id                 String             @id @default(uuid()) @db.Uuid
  kind               OrganizationKind
  displayName        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  roleGrants         RoleGrant[]
  serviceAssignments ServiceAssignment[]

  @@index([kind, createdAt])
  @@map("organizations")
}

enum ProductPublicationStatus {
  draft
  under_review
  changes_requested
  approved
  published
}

model ArtistProduct {
  id                String                   @id @default(uuid()) @db.Uuid
  artistUserId      String                   @db.Uuid
  artist            IdentityUser             @relation(fields: [artistUserId], references: [id], onDelete: Restrict)
  title             String
  description       String?
  priceToman        BigInt
  publicationStatus ProductPublicationStatus @default(draft)
  archivedAt        DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  publicationEvents ProductPublicationEvent[]
  media             ArtistProductMedia[]

  @@index([artistUserId, archivedAt, updatedAt])
  @@index([publicationStatus, archivedAt])
  @@map("artist_products")
}

model ProductPublicationEvent {
  id                String                   @id @default(uuid()) @db.Uuid
  productId         String                   @db.Uuid
  product           ArtistProduct             @relation(fields: [productId], references: [id], onDelete: Cascade)
  actorUserId       String                   @db.Uuid
  actor             IdentityUser              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  status            ProductPublicationStatus
  feedback          String?
  createdAt         DateTime                 @default(now())

  @@index([productId, createdAt])
  @@map("product_publication_events")
}

enum ProductMediaStatus {
  pending
  ready
}

model ArtistProductMedia {
  id            String            @id @default(uuid()) @db.Uuid
  productId     String            @db.Uuid
  product       ArtistProduct     @relation(fields: [productId], references: [id], onDelete: Cascade)
  objectKey     String            @unique
  contentType   String
  contentLength Int
  status        ProductMediaStatus @default(pending)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([productId, status, createdAt])
  @@map("artist_product_media")
}

model ServiceRequest {
  id             String              @id @default(uuid()) @db.Uuid
  partnerTitle   String
  partnerSummary String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  assignments    ServiceAssignment[]

  @@map("service_requests")
}

model ServiceAssignment {
  id                    String         @id @default(uuid()) @db.Uuid
  serviceRequestId      String         @db.Uuid
  serviceRequest        ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  partnerOrganizationId String         @db.Uuid
  partnerOrganization   Organization   @relation(fields: [partnerOrganizationId], references: [id], onDelete: Restrict)
  assignedPartnerUserId String?        @db.Uuid
  assignedPartnerUser   IdentityUser?  @relation("ServiceAssignmentUser", fields: [assignedPartnerUserId], references: [id], onDelete: Restrict)
  assignedByUserId      String?        @db.Uuid
  assignedBy            IdentityUser?  @relation("ServiceAssignmentAuthor", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt            DateTime       @default(now())
  responseStatus        ServiceAssignmentResponseStatus @default(awaiting_response)
  respondedAt           DateTime?
  createdAt             DateTime       @default(now())
  deliverables          ServiceDeliverable[]
  responseEvents        ServiceAssignmentEvent[]

  @@index([partnerOrganizationId, assignedPartnerUserId, assignedAt])
  @@index([serviceRequestId, assignedAt])
  @@index([assignedByUserId, createdAt])
  @@map("service_assignments")
}

enum ServiceAssignmentResponseStatus {
  awaiting_response
  accepted
  declined
}

enum ServiceAssignmentResponseEventType {
  accepted
  declined
}

model ServiceAssignmentEvent {
  id           String                              @id @default(uuid()) @db.Uuid
  assignmentId String                              @db.Uuid
  assignment   ServiceAssignment                   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actorUserId  String                              @db.Uuid
  actor        IdentityUser                        @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  type         ServiceAssignmentResponseEventType
  createdAt    DateTime                            @default(now())

  @@index([assignmentId, createdAt])
  @@map("service_assignment_events")
}

enum ServiceDeliverableStatus {
  pending
  ready
}

model ServiceDeliverable {
  id               String                  @id @default(uuid()) @db.Uuid
  assignmentId     String                  @db.Uuid
  assignment       ServiceAssignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  uploadedByUserId String                  @db.Uuid
  uploadedBy       IdentityUser            @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  objectKey        String                  @unique
  fileName         String
  contentType      String
  contentLength    Int
  status           ServiceDeliverableStatus @default(pending)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  submission       ServiceDeliverableSubmission?

  @@index([assignmentId, status, createdAt])
  @@map("service_deliverables")
}

model ServiceDeliverableSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  deliverableId  String           @unique @db.Uuid
  deliverable    ServiceDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  actorUserId    String           @db.Uuid
  actor          IdentityUser     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())

  @@index([actorUserId, createdAt])
  @@map("service_deliverable_submissions")
}

model OtpChallenge {
  id             String    @id @default(uuid()) @db.Uuid
  phone          String    @unique
  codeHash       String
  expiresAt      DateTime
  consumedAt     DateTime?
  failedAttempts Int       @default(0)
  requestCount   Int       @default(1)
  windowStartedAt DateTime
  nextRequestAt  DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("otp_challenges")
}

model AuthSession {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String       @unique
  expiresAt DateTime
  revokedAt DateTime?
  activeGrantId String?    @db.Uuid
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("auth_sessions")
}

enum IdentityRole {
  customer
  artist
  staff
  service_partner
  supporting_organization
  corporate_buyer
  export_partner
}

model RoleGrant {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @db.Uuid
  user            IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            IdentityRole
  organizationId  String?      @db.Uuid
  organization    Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  exportPartnerId String?      @db.Uuid
  revokedAt       DateTime?
  createdAt       DateTime     @default(now())
  staffDomains    StaffDomainGrant[]

  @@index([userId, revokedAt])
  @@index([organizationId, role, revokedAt])
  @@map("role_grants")
}

model StaffDomainGrant {
  id        String    @id @default(uuid()) @db.Uuid
  roleGrantId String  @db.Uuid
  roleGrant RoleGrant @relation(fields: [roleGrantId], references: [id], onDelete: Cascade)
  domain    String

  @@unique([roleGrantId, domain])
  @@map("staff_domain_grants")
}
