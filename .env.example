NODE_ENV=development
WEB_URL=http://localhost:3000
API_PORT=4000
DATABASE_URL=postgresql://negarin:negarin@localhost:5432/negarin?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=negarin-local
S3_ACCESS_KEY_ID=negarin
S3_SECRET_ACCESS_KEY=negarin-local-secret
OTEL_SDK_DISABLED=true

# Server-only Next.js BFF target. Never expose bearer tokens through NEXT_PUBLIC_* variables.
NEGARIN_API_URL=http://localhost:4000
# Local development escape hatch for attaching a pre-existing API session; disabled by default and blocked in production.
NEGARIN_DEV_SESSION_ATTACH=0
